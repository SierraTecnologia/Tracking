{
    "name": "sierratecnologia/tracking",
    "description": "Rastreio comportamental de visitantes e leads para Laravel: tracker.js universal, ingestão por beacon, jornada e engajamento prontos para o CRM.",
    "type": "library",
    "keywords": [
        "sierratecnologia",
        "tracking",
        "behavioral",
        "lead-tracking",
        "journey",
        "analytics",
        "laravel"
    ],
    "license": "MIT",
    "homepage": "https://sierratecnologia.com/packages/tracking/",
    "support": {
        "email": "help@sierratecnologia.com",
        "issues": "https://github.com/sierratecnologia/tracking/issues",
        "source": "https://github.com/sierratecnologia/tracking",
        "docs": "https://github.com/sierratecnologia/tracking/blob/master/README.md"
    },
    "authors": [
        {
            "name": "SierraTecnologia",
            "homepage": "https://sierratecnologia.com.br",
            "email": "help@sierratecnologia.com.br"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/events": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Tracking\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tracking\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Tracking\\TrackingProvider"
            ],
            "aliases": {
                "Tracking": "Tracking\\Facades\\Tracking"
            }
        }
    },
    "version": "2.3.0"
}
