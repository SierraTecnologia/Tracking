{
    "name": "sierratecnologia/tracking",
    "description": "Tracking",
    "type": "library",
    "keywords": [
        "sierratecnologia",
        "tracking"
    ],
    "license": "MIT",
    "homepage": "https://sierratecnologia.com/packages/tracking/",
    "support": {
        "email": "help@sierratecnologia.com",
        "issues": "https://github.com/sierratecnologia/tracking/issues",
        "source": "https://github.com/sierratecnologia/tracking",
        "docs": "https://github.com/sierratecnologia/tracking/blob/master/README.md"
    },
    "authors": [
        {
            "name": "SierraTecnologia",
            "homepage": "https://sierratecnologia.com.br",
            "email": "help@sierratecnologia.com.br"
        }
    ],
    "require": {
        "php": "^8.3",
        "geoip2/geoip2": "^3.4",
        "illuminate/bus": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "jenssegers/agent": "^2.6",
        "donatj/phpuseragentparser": "^1.11",
        "sierratecnologia/countries": "^2.0",
        "sierratecnologia/muleta": "^2.0",
        "symfony/http-foundation": "^7.2",
        "torann/geoip": "^3.0",
        "ua-parser/uap-php": "^3.10",
        "sierratecnologia/audit": "^2.0",
        "ricardosierra/larametrics": "^2.0",
        "wnx/laravel-stats": "^2.20",
        "guzzlehttp/guzzle": "^7.10",
        "laravel/horizon": "^5.49",
        "spatie/laravel-analytics": "^5.7"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.68",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Tracking\\": "src/"
        }
    },
    "scripts": {
        "psalm": "vendor/bin/psalm",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes",
        "check-style": "phpcs -p --standard=PSR12 src --extensions=php",
        "fix-style": "phpcbf -p --standard=PSR12 src --extensions=php"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../**",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Tracking\\TrackingProvider"
            ]
        }
    },
    "version": "2.0.0"
}
